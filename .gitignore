*.iml
.gradle/
/local.properties
/.idea/
/build/
/app/build/
/.codex/
/.kotlin/

# Tooling output
/.impeccable/

# Source documents (the assignment brief)
/Project Details/

# Firebase client/server credentials and local tooling
/app/google-services.json
**/*service-account*.json
.firebase/
firebase-debug.log

# Free Vercel Clerk-to-Firebase bridge
bridge/.env*
!bridge/.env.example
bridge/node_modules/
bridge/.vercel/

# Build keys. Publishable or not, no key is tracked. See keys.properties.example.
/keys.properties
secrets.properties
apikeys.properties

# Environment files anywhere in the tree. `*.env` alone missed the common
# names: it matches `foo.env` and `.env`, but not `.env.local`, which is
# exactly what a local run writes.
*.env
.env
.env.*
!.env.example
!**/.env.example
secrets.json

# Release signing. The keystore and its passwords never enter the repository.
/keystore.properties
*.jks
*.keystore

# Word owner files. Orphaned whenever Word exits badly, and never wanted.
~$*
