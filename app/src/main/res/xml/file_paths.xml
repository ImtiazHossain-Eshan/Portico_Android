<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Exports are written to the cache and shared by content URI, so no
         storage permission is needed and nothing is left in shared storage. -->
    <cache-path name="exports" path="exports/" />
    <!-- Authenticated downloads are staged here only long enough to hand the
         private file to the user's chosen viewer. -->
    <cache-path name="documents" path="documents/" />
    <!-- Documents kept on the device when there is no server to hold them.
         Written by storeLocally and opened straight from here, so they are
         shared by content URI like anything else the reader is handed. -->
    <files-path name="local_documents" path="local/documents/" />
</paths>
