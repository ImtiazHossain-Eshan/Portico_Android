CLERK_ISSUER=https://your-instance.clerk.accounts.dev
FIREBASE_PROJECT_ID=portico-489
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Required for account deletion: removes the Clerk identity itself.
CLERK_SECRET_KEY=

# Gemma-backed portfolio assistant. Without a key the endpoint reports
# not_configured and the app falls back to its on-device analyst.
# Key from Google AI Studio: https://aistudio.google.com/apikey
GEMMA_API_KEY=
GEMMA_MODEL=gemma-3-27b-it

# SSLCommerz gateway. Register at https://sandbox-gw.sslcommerz.com/register
# to get sandbox store credentials. Leave PORTICO_BILLING_MODE as "sandbox" to
# keep the built-in fake-card flow; set it to "sslcommerz" to route checkout
# through the gateway.
PORTICO_BILLING_MODE=sandbox
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWD=
# Anything other than an explicit "false" stays on the sandbox host.
SSLCZ_SANDBOX=true
# Absolute origin of this deployment. SSLCommerz calls back to it, so it cannot
# be relative. Falls back to VERCEL_URL when unset.
PORTICO_PUBLIC_URL=

# Platform administration. Comma-separated Clerk user ids permitted to read
# across every tenant and to change plans or lock sign-in. Granted here and
# nowhere else: a privilege the app itself could grant is not a privilege.
# Leave empty to disable the admin surface entirely.
PORTICO_ADMIN_USER_IDS=
