rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Every member-owned record lives below the Firebase UID. The Clerk bridge
    // mints Firebase identities with the Clerk user ID as that UID.
    match /users/{userId} {
      allow read, create, update, delete: if owns(userId);

      // Property creation is routed through the authenticated bridge so the
      // Free-plan limit is checked atomically. Owners can still edit/remove
      // their own records.
      match /properties/{propertyId} {
        allow read, update, delete: if owns(userId);
        allow create: if false;
      }

      // Billing facts and quotas are server-owned. The mobile client can read
      // the effective plan but cannot grant itself Pro or forge a receipt.
      match /settings/{settingId} {
        allow read: if owns(userId);
        allow create, update, delete: if owns(userId) &&
          !(settingId in ['subscription', 'quota', 'aiUsage']);
      }

      match /payments/{paymentId} {
        allow read: if owns(userId);
        allow write: if false;
      }

      match /devices/{deviceId} {
        allow read, write: if false;
      }

      match /{collection}/{documentId} {
        allow read, create, update, delete: if owns(userId) &&
          collection in [
            'income', 'expenses', 'valuations', 'documents', 'activity',
            'notifications', 'conversations', 'workspace'
          ];
      }

      // Legacy nested data remains readable during migration, but new unknown
      // paths are closed by default.
      match /workspace/{document=**} {
        allow read, create, update, delete: if owns(userId);
      }
    }

    // Public market reference data is readable only inside the signed-in app.
    match /public/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Payment facts are written only by trusted server code. Members can read
    // their own receipts, but the Android client cannot manufacture one.
    match /payments/{paymentId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
