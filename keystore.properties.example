# Copy to keystore.properties (gitignored) and fill in.
# Create the keystore yourself, never commit it:
#
#   keytool -genkey -v -keystore portico-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias portico
#
storeFile=portico-release.jks
storePassword=
keyAlias=portico
keyPassword=
